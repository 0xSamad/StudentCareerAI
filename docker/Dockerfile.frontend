# ==============================================================================
# Dockerfile.frontend — Next.js production build
# The web app imports repo-root lib/ and *.mjs files, so the image keeps
# the monorepo layout: /repo/web + /repo/lib + /repo/node_modules.
# ==============================================================================

FROM node:22-alpine AS base
WORKDIR /repo
ENV NEXT_TELEMETRY_DISABLED=1
ENV STUDENT_CAREER_AI_ROOT=/repo
ENV NODE_PATH=/repo/node_modules:/repo/web/node_modules

FROM base AS deps
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts
WORKDIR /repo/web
COPY web/package.json web/package-lock.json* ./
RUN npm install --ignore-scripts

FROM base AS builder
COPY --from=deps /repo/node_modules /repo/node_modules
COPY --from=deps /repo/web/node_modules /repo/web/node_modules
COPY . /repo
WORKDIR /repo/web
RUN npm run build

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV STUDENT_CAREER_AI_ROOT=/repo
ENV NODE_PATH=/repo/node_modules:/repo/web/node_modules

RUN apk add --no-cache wget && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /repo /repo

WORKDIR /repo/web
USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

CMD ["npm", "start"]

# ==============================================================================
# StudentCareer AI — Production Environment Variables Blueprint
# Copy this file to .env in your production environment and fill in the values.
# NEVER COMMIT SECRETS OR FILLED .env FILES TO GIT.
# ==============================================================================

NODE_ENV=production
PORT=3000
API_PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# REQUIRED for production readiness (/readyz) and persisted multi-user auth.
# Without DATABASE_URL the API still boots (in-memory AuthService Maps) but
# /readyz reports database UNHEALTHY and ready=false — it will NOT fake success.
#
# Local example:
#   DATABASE_URL=postgresql://career_user:career_pass@localhost:5432/student_career_ai
# Docker Compose example (service hostname "postgres"):
DATABASE_URL=postgresql://career_prod_user:StrongRandomDbPasswordHere@postgres:5432/student_career_ai_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=career_prod_user
POSTGRES_PASSWORD=StrongRandomDbPasswordHere
POSTGRES_DB=student_career_ai_prod
DATABASE_SSL=false
DATABASE_MAX_POOL=25
# Apply schema: npm run db:migrate  (requires a reachable DATABASE_URL)

# ------------------------------------------------------------------------------
# 2. AI Model Providers (OpenRouter / OpenAI / Anthropic)
# ------------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-5.6-luna
OPENROUTER_API_KEY=sk-or-v1-production-key-here
OPENAI_API_KEY=sk-production-openai-key-here
ANTHROPIC_API_KEY=sk-ant-production-key-here
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2b. Job Search APIs (optional; used after indexed search + curated companies)
# ------------------------------------------------------------------------------
# Adzuna requires BOTH an app id and app key.
# Adzuna has no Pakistan (pk) country endpoint; use gb,us,ca,in,sg,au,za for API search.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_COUNTRIES=gb,us,ca,in,sg,au,za

# ------------------------------------------------------------------------------
# 3. File & Document Storage (Local or AWS S3)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/data/storage
S3_BUCKET=studentcareer-production-artifacts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-me-aws-secret-access-key

# ------------------------------------------------------------------------------
# 4. Email & Notifications (Transactional SMTP / SendGrid)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=replace-me-sendgrid-api-key
SMTP_FROM=support@studentcareer.ai
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 5. Production Authentication & Cryptography Secrets (Generate with `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
SESSION_SECRET=generate_strong_64_char_random_hex_for_sessions_here
JWT_SECRET=generate_strong_64_char_random_hex_for_jwt_tokens_here
CSRF_SECRET=generate_strong_64_char_random_hex_for_csrf_protection
SESSION_TTL_HOURS=24
PASSWORD_SALT_ROUNDS=12
# Set false for plain HTTP (IP:3000 demos). true when the site is served over HTTPS.
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 6. Payment Processing (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=replace-me-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-me-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=replace-me-stripe-publishable-key

# ------------------------------------------------------------------------------
# 7. Monitoring & Error Tracking (Sentry)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=https://examplePublicKey@o123456.ingest.sentry.io/7891011
# 7. Apply (local vs server)
# ------------------------------------------------------------------------------
# Local clone: leave APPLY_HEADLESS=false so Google Chrome opens on YOUR computer.
# Attach / Google Drive / CAPTCHA then use your files and accounts.
# Docker production sets APPLY_HEADLESS=true (server Chromium — no local files).
APPLY_HEADLESS=false
NEXT_PUBLIC_APPLY_LIVE_WINDOW=false

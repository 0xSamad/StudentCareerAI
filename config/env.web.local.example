# Copy to web/.env.local — never commit web/.env.local
APPLY_HEADLESS=false
NEXT_PUBLIC_APPLY_LIVE_WINDOW=false
STUDENT_CAREER_AI_ROOT=..
COOKIE_SECURE=false

# Same secrets as repo-root .env. Use 127.0.0.1, not Docker hostname "postgres".
DATABASE_URL=postgresql://career_prod_user:CHANGE_ME@127.0.0.1:5432/student_career_ai_prod
SESSION_SECRET=change-me
JWT_SECRET=change-me
CSRF_SECRET=change-me
